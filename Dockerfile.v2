# Dockerfile.vulnerable
# Dùng để test Trivy scan — KHÔNG dùng production

# base image cũ, nhiều CVE
FROM python:3.6

# chạy với root — misconfig
USER root

# dependency cũ, có CVE đã biết
RUN pip install \
    django==2.2.0 \
    flask==0.12.0 \
    requests==2.6.0 \
    pyyaml==3.13

# copy toàn bộ context vào — misconfig (copy cả .env, secret, ...)
COPY . /app

WORKDIR /app

# expose port không cần thiết
EXPOSE 22
EXPOSE 8080

CMD ["python", "app.py"]